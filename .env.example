#---------------------------------------------------------------------------
# Database
#---------------------------------------------------------------------------
POSTGRES_URL=postgres://postgres:bridge@localhost:5432/bridgedb?sslmode=disable&timezone=UTC
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=bridge
POSTGRES_DATABASE_LOCATION=local
#---------------------------------------------------------------------------
# Application Environment Variables
#---------------------------------------------------------------------------
# NEXT_PUBLIC_APPENV_ISDEV: "true" enables verbose logging
# NEXT_PUBLIC_APPENV_DBHANDLER: "PG" for local PostgreSQL, "VERCEL_PG" for Vercel Postgres
#---------------------------------------------------------------------------
NEXT_PUBLIC_APPENV_ISDEV=true
NEXT_PUBLIC_APPENV_DBHANDLER=PG
#---------------------------------------------------------------------------
# Admin auth — set ADMIN_AUTH_ENABLED=true to activate the login guard
#---------------------------------------------------------------------------
ADMIN_PASSWORD=changeme
ADMIN_AUTH_ENABLED=false
#---------------------------------------------------------------------------
# Cron job — set CRON_SECRET to protect /api/cron/update-sessions
# Leave unset for local testing (auth is skipped when CRON_SECRET is not set)
#---------------------------------------------------------------------------
CRON_SECRET=
#---------------------------------------------------------------------------
# Scripts:
#   npm run locallocal  — port 3020, local DB
#   npm run localdev    — port 3021, remote dev DB (Vercel/Neon)
#   npm run localprod   — port 3022, remote prod DB (Vercel/Neon)
#---------------------------------------------------------------------------
