{
  "git": {
    "deploymentEnabled": true
  },
  "crons": [
    { "path": "/api/build/start-run?to_date=",                                     "schedule": "50 12 * * *" },
    { "path": "/api/build/scrape-akbc-day?batch=1&to_date=&fetch_timeout_ms=",      "schedule": "5 13 * * *" },
    { "path": "/api/build/scrape-akbc-day?batch=2&to_date=&fetch_timeout_ms=",      "schedule": "35 13 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=1&to_date=&fetch_timeout_ms=", "schedule": "0 14 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=2&to_date=&fetch_timeout_ms=", "schedule": "10 14 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=3&to_date=&fetch_timeout_ms=", "schedule": "20 14 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=4&to_date=&fetch_timeout_ms=", "schedule": "30 14 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=5&to_date=&fetch_timeout_ms=", "schedule": "40 14 * * *" },
    { "path": "/api/build/scrape-tracked-batch?batch=6&to_date=&fetch_timeout_ms=", "schedule": "50 14 * * *" },
    { "path": "/api/build/partners",                                               "schedule": "10 15 * * *" },
    { "path": "/api/build/stats-player",                                           "schedule": "20 15 * * *" },
    { "path": "/api/build/stats-partner",                                          "schedule": "25 15 * * *" }
  ]
}
